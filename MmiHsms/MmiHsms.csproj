<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MMISoft.HSMS</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Normal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Normal.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Normal.ico" />
    <EmbeddedResource Include="Select.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ConfigForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
